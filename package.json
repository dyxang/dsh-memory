{
  "name": "@dyxang/dsh-memory",
  "version": "0.3.1",
  "description": "File-based persistent agent memory: one Markdown file per fact, an always-on rule layer plus an on-demand index injected into every prompt, and automatic extraction after each turn.",
  "license": "MIT",
  "author": "dyxang",
  "homepage": "https://github.com/dyxang/dsh-memory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyxang/dsh-memory.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "persistent-memory",
    "agent-memory"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "host",
    "scripts",
    "vendor",
    "market",
    "icon.svg",
    "locale",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "Memory",
    "description": "File-based persistent agent memory: one Markdown file per fact, an always-on rule layer plus an on-demand index injected into every prompt, and automatic extraction after each turn."
  },
  "scripts": {
    "ensure-deps": "node scripts/ensure-deps.mjs",
    "check-deps": "node scripts/ensure-deps.mjs --check",
    "postinstall": "node scripts/ensure-deps.mjs",
    "prepare": "node scripts/ensure-deps.mjs",
    "build:market": "node scripts/build-market-index.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
